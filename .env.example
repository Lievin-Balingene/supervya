# ---------------------------------------------------------------------------
# Supervya — variables d'environnement (exemple, aucun secret réel)
# Copier vers .env et adapter avant le démarrage.
# ---------------------------------------------------------------------------

TZ=Europe/Paris

# --- Base PostgreSQL Supervya (Django) ---
SUPERVYA_DB_USER=supervya
SUPERVYA_DB_PASSWORD=changer_moi_supervya
SUPERVYA_DB_NAME=supervya
SUPERVYA_DB_HOST=postgres-supervya
SUPERVYA_DB_PORT=5432

# --- Base PostgreSQL Zabbix ---
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=changer_moi_zabbix
ZABBIX_DB_NAME=zabbix

# --- Ports exposés ---
ZABBIX_SERVER_PORT=10051
ZABBIX_WEB_PORT=8080
SUPERVYA_WEB_PORT=8000

# --- Django ---
DJANGO_SECRET_KEY=changer_moi_cle_secrete_django
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://supervya:changer_moi_supervya@postgres-supervya:5432/supervya

# --- API Zabbix (JSON-RPC) ---
# URL interne Docker ; jeton créé dans l'interface Zabbix (Administration > Users > API tokens)
ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php
ZABBIX_API_TOKEN=changer_moi_jeton_api_zabbix
ZABBIX_SERVER_ACTIVE=zabbix.exemple.com:10051

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- E-mails ---
EMAIL_HOST=smtp.exemple.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Supervya <alertes@exemple.com>

# --- Installation agent (commandes affichées aux clients) ---
# URL publique joignable depuis les machines clientes (ex. https://supervya.votredomaine.com)
SUPERVYA_PUBLIC_URL=
# Dépôt des scripts (raw GitHub)
SUPERVYA_SCRIPTS_BASE=https://raw.githubusercontent.com/Lievin-Balingene/supervya/main/scripts
